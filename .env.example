# --- Flask Settings ---
FLASK_APP=app.py
FLASK_ENV=production
FLASK_DEBUG=0
PORT=5000

# Security Key (Change this in production!)
SECRET_KEY=change-me-to-a-random-string

# --- Database (PostgreSQL) ---
# When using Docker Compose, DB_HOST should be 'db'
DB_HOST=db
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=0000
DB_DATABASE=mapping

# Optional: Direct DATABASE_URL (takes precedence if set)
# DATABASE_URL=postgresql+psycopg2://postgres:0000@db:5432/mapping

# --- Dev UX / Performance ---
TEMPLATES_AUTO_RELOAD=0
SEND_FILE_MAX_AGE_DEFAULT=31536000
