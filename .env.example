## Flask dev settings (auto-reload on code/template changes)
FLASK_ENV=development
FLASK_DEBUG=1

## Optional: force template auto-reload (useful while designing)
TEMPLATES_AUTO_RELOAD=1

## Optional: prevent aggressive caching of static files in dev
SEND_FILE_MAX_AGE_DEFAULT=0

## App port
PORT=5000

## Database (PostgreSQL)
## Option A (recommended): use separate DB_* vars (your app.py supports this)
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=your_db_user
DB_PASSWORD=your_db_password
DB_DATABASE=your_db_name

## Option B: single URL (uncomment if you prefer)
# DATABASE_URL=postgresql+psycopg2://user:password@127.0.0.1:5432/dbname
